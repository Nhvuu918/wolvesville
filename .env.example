# Local macOS development: copy to .env and fill DATABASE_URL manually.
# Obtain the CURRENT password from your existing PostgreSQL container settings.
# Never commit .env; never replace existing Docker volumes because of a password error.
DB_PROVIDER=sqlite
# Required ONLY when DB_PROVIDER=postgres (your existing PostgreSQL instance).
DATABASE_URL=
WV_INTEGRATION_TEST_MODE=0
WV_OFFICIAL_RULE_TEST_MODE=0
# Development only; disabled unless explicitly enabled; ALWAYS disabled if NODE_ENV=production.
WV_ENABLE_DEMO_AUTH=0
WV_REQUIRE_POSTGRES=0
PORT=3212
HOST=127.0.0.1

# Local-only B/B live QA profiles (SQLite + loopback + WV_OFFICIAL_RULE_TEST_MODE=1).
# Never enable for production. Does not publish ruleset 1.3.4.
WV_OWNER_BB_LIVE_QA=0

# Candidate QA only, requires explicit opt-in; not enabled by dev:demo.
WV_RC01_LIFE02_QA=0
WV_FULL50_QA=0
WV_OWNER_CULT_QA=0
# Optional SQLite path. Default: ./local/sprint03.sqlite (never reset automatically).
# WV_LOBBY_DB=./local/sprint03.sqlite

# Local development only: composition-based Guard + observation Normal scope.
# Default disabled; does not activate official rules or competitive production.
WV_LIFE_MODULES_DEV_NORMAL=0

# Immersive optional server-side AI provider; disabled by default.
WV_AI_ENABLED=0
WV_AI_MODEL=
WV_AI_API_KEY=
WV_AI_BASE_URL=https://api.openai.com/v1

# Public ordinary declared counts only for newly created compatible Normal games.
WV_PUBLIC_ORDINARY_VOTE=1
# Cloud staging uses npm start, not dev:demo. Set on Railway, not local .env:
# NODE_ENV=production
# WV_DEPLOYMENT_PROFILE=CLOUD_STAGING
# DB_PROVIDER=postgres
# HOST=0.0.0.0
# ALLOWED_ORIGINS=https://your-generated-domain.example

# Owner IMMERSIVE-04: authorized permanent functional groups day/night.
# Opt in for new games only. Historical games keep their saved policy.
WV_GROUP_CHAT_DAY_NIGHT=0
